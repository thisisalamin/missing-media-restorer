<?xml version="1.0"?>
<ruleset name="Missing Media Restorer">
	<description>WordPress plugin code standards</description>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.VIP" />
	</rule>

	<!-- Suppress false positives for superglobals -->
	<rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis">
		<properties>
			<property name="allowSuperglobals" value="true" />
		</properties>
	</rule>
</ruleset>
